#!/usr/bin/env bash

# ==============================================================================
#  BSPWM CONFIGURATION - CATPPUCCIN MOCHA THEME
# ==============================================================================

# 1. Kill old instances of daemons/bars
killall -q sxhkd polybar picom dunst conky
python3 "$HOME/Scripts/desktop-menu/desktop_menu.py" --kill 2>/dev/null || true

# 2. Start SXHKD (Hotkeys daemon)
sxhkd -c "$HOME/.config/sxhkd/sxhkdrc" &

# 3. Workspaces / Desktops & Display setup
bspc config remove_disabled_monitors  true
bspc config remove_unplugged_monitors true
bspc config merge_overlapping_monitors true

if [ -x "$HOME/.config/bspwm/scripts/display.sh" ]; then
    "$HOME/.config/bspwm/scripts/display.sh" apply
else
    bspc monitor -d "1" "2" "3" "4" "5" "6"
fi


# 4. Window Manager Styling & Behavior
bspc config border_width          2
bspc config window_gap            10
bspc config top_padding           30
bspc config ignore_ewmh_struts    true
bspc config split_ratio           0.52
bspc config borderless_monocle    true
bspc config gapless_monocle       true
bspc config focus_follows_pointer true
bspc config pointer_follows_focus false
bspc config pointer_follows_monitor false
bspc config pointer_modifier      mod4
bspc config pointer_action1       move
bspc config pointer_action2       resize_side
bspc config pointer_action3       resize_corner

# Catppuccin Mocha Border Colors
bspc config normal_border_color   "#313244"
bspc config active_border_color   "#585b70"
bspc config focused_border_color  "#cba6f7"
bspc config presel_feedback_color "#f5c2e7"

# 5. Window Rules
bspc rule -a Feh state=floating center=on
bspc rule -a Pavucontrol state=floating center=on
bspc rule -a Nitrogen state=floating center=on
bspc rule -a Lxappearance state=floating center=on
bspc rule -a Yad state=floating center=on
bspc rule -a Zenity state=floating
bspc rule -a Flameshot state=floating
bspc rule -a SimpleScreenRecorder state=floating center=on

# Custom floating window rules for ricing utilities
bspc rule -a Kitty:kitty-float state=floating center=on rectangle=900x520+0+0
bspc rule -a Kitty:cava-term state=floating center=on rectangle=840x400+0+0
bspc rule -a Kitty:clock-term state=floating center=on rectangle=520x280+0+0
bspc rule -a Kitty:neofetch-term state=floating center=on rectangle=900x540+0+0
bspc rule -a Kitty:cmatrix-term state=floating center=on rectangle=900x540+0+0
bspc rule -a Kitty:ranger-term state=floating center=on rectangle=1000x600+0+0
bspc rule -a Kitty:shortcut-term state=floating center=on rectangle=820x650+0+0
bspc rule -a Kitty:mixer-term state=floating center=on rectangle=800x500+0+0
bspc rule -a Kitty:btop-term state=floating center=on rectangle=1050x650+0+0
bspc rule -a Kitty:ytmusic-term state=floating center=on rectangle=960x560+0+0
bspc rule -a Kitty:netmon-term state=floating center=on rectangle=980x600+0+0
bspc rule -a Kitty:dockman-term state=floating center=on rectangle=1050x700+0+0
bspc rule -a Kitty:gitman-term state=floating center=on rectangle=1050x700+0+0
bspc rule -a Kitty:cleaner-term state=floating center=on rectangle=1020x680+0+0
bspc rule -a Kitty:clipvault-term state=floating center=on rectangle=980x640+0+0
bspc rule -a Kitty:palette-term state=floating center=on rectangle=1020x680+0+0
bspc rule -a Kitty:lanshare-term state=floating center=on rectangle=1000x700+0+0
bspc rule -a Kitty:netscout-term state=floating center=on rectangle=1020x680+0+0
bspc rule -a Kitty:quicknote-term state=floating center=on rectangle=950x620+0+0
bspc rule -a Kitty:sniper-term state=floating center=on rectangle=1020x680+0+0
bspc rule -a Kitty:autostart-term state=floating center=on rectangle=1020x680+0+0
bspc rule -a Kitty:guava-term state=floating center=on rectangle=1020x680+0+0

# 6. Autostart Applications & Services
# Set Wallpaper
if [ -f "$HOME/.config/bspwm/scripts/set_wallpaper.sh" ]; then
    bash "$HOME/.config/bspwm/scripts/set_wallpaper.sh" &
fi

# Compositor (Picom - Disabled)
# picom --config "$HOME/.config/picom/picom.conf" -b &

# Notification Daemon (Dunst)
dunst -config "$HOME/.config/dunst/dunstrc" &

# Polybar (Top Floating Bar)
if [ -f "$HOME/.config/polybar/launch.sh" ] && ! pgrep -x polybar >/dev/null; then
    bash "$HOME/.config/polybar/launch.sh" &
fi

# Playerctl daemon for media keys
if command -v playerctld &>/dev/null; then
    playerctld daemon &
fi

# Cursor setting
xsetroot -cursor_name left_ptr &

# Desktop Right-Click Context Menu Daemon
if [ -x "$HOME/Scripts/desktop-menu/desktop_menu.py" ]; then
    python3 "$HOME/Scripts/desktop-menu/desktop_menu.py" --daemon &
fi


