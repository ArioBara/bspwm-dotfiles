# ==============================================================================
#  DUNST NOTIFICATION CONFIGURATION - CATPPUCCIN MOCHA THEME
# ==============================================================================

[global]
    monitor = 0
    follow = mouse
    width = (300, 380)
    height = 120
    origin = top-right
    offset = 20x60
    scale = 0
    notification_limit = 5

    # Progress bar
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4

    indicate_hidden = yes
    transparency = 5
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    frame_width = 2
    frame_color = "#7aa2f7"
    gap_size = 6
    separator_color = frame
    sort = yes
    idle_threshold = 120

    # Typography
    font = JetBrainsMono Nerd Font 10
    line_height = 3
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # Icons
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_path = /usr/share/icons/Papirus/32x32/status/:/usr/share/icons/Papirus/32x32/devices/:/usr/share/icons/Papirus/32x32/apps/

    # Aesthetics & Corner Radius
    corner_radius = 12
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1a1b26"
    foreground = "#cdd6f4"
    frame_color = "#7aa2f7"
    timeout = 4

[urgency_normal]
    background = "#1a1b26"
    foreground = "#cdd6f4"
    frame_color = "#7aa2f7"
    timeout = 6

[urgency_critical]
    background = "#1a1b26"
    foreground = "#cdd6f4"
    frame_color = "#7aa2f7"
    timeout = 0
