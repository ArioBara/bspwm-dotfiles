[Desktop Entry]
Name=System & Storage Cleaner
Comment=Linux Mint Storage & Cache Maintenance TUI
Exec=kitty --class cleaner-term -T "🧹 System & Storage Cleaner" -e /home/ario/.local/bin/system-cleaner
Icon=edit-clear
Terminal=false
Type=Application
Categories=System;Utility;
Keywords=cleaner;cache;disk;trash;storage;maintenance;
